<!DOCTYPE html>
<html lang='en'>
    <head>
        <meta charset='utf-8'>
        <meta name='viewport' content='width=device-width, initial-scale=1'>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" 
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <title>Blog Web Application</title>
        <link rel='stylesheet' type="text/css" href='styles/style.css'>
    </head>
    <body>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <h3>Blog Web Application</h3>
                <h4>Logged in as: <%= currUser[0].name %></h4>
            </div>
        </nav>
        <!-- Page content-->
        <div class="container mt-5">
            <div class="row">
                <div class="col-lg-8">
                    <!-- insert posts here -->
                    <% for(let posts of blogPost){%>
                    <div class="card mb-4">
                        <div class="card-body">
                            <h4 class="mb-2"><%= posts.title %></h4>
                            <p class="mb-4"><%= posts.creator_name %> <%= posts.date_created %></p>
                            <p><%= posts.body %></p>
                            
                            <form class="edit" action="/edit" method="post">
                                <input type="hidden" name="updatedId" value="<%= posts.blog_id %>">
                                <input id="inputT<%= posts.blog_id %>" type="text" name="updatedTitle" value="<%= posts.title %>" autocomplete="off"
                                    autofocus="true" hidden="true" class="rounded form-control mb-3"/>
                                <input id="inputB<%= posts.blog_id %>" type="text" name="updatedBody" value="<%= posts.body %>" autocomplete="off"
                                    autofocus="true" hidden="true" class="rounded form-control mb-3" style="width: 95%; padding-bottom: 15%; padding-top: 3%;"/>
                                <button id="done<%=posts.blog_id%>" class="btn mb-2" 
                                    style="height: 40px;" type="submit" hidden
                                    >Done</button>
                            </form>
                            <button id="edit<%=posts.blog_id%>" class="btn mb-2" 
                                    style="height: 40px;" onclick="handler('<%=posts.blog_id%>')"
                                    >Edit Post</button>
                            <form action="/delete" method="POST">
                                <button class="btn" style="height: 40px"
                                    name="deleteItemId" value=
                                    "<%= posts.blog_id %>">Delete Post</button>
                            </form>
                        </div>
                    </div>
                    <% } %>
                </div>

                <div class="col-lg-4">
                    <!-- Create a post -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <h4 class="mb-3">Create Post</h4>

                            <form action="/addPost" method="POST">
                                <div class="form-group">
                                    <input type="text" name="newTitle" class="rounded form-control mb-3" 
                                        placeholder="Enter title..." style="width: 95%;" autocomplete="off">
                                    <input type="text" name="newBody" class="rounded form-control mb-3" 
                                        placeholder="Enter body..." style="width: 95%; padding-bottom: 50%; padding-top: 5%;" autocomplete="off">
                                </div>

                                <button class="btn" id="addPost" style="height: 40px">Add Post</button>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function handler(id) {
            document.getElementById("edit" + id).setAttribute("hidden", true);
            document.getElementById("done" + id).removeAttribute("hidden");
            document.getElementById("inputT" + id).removeAttribute("hidden");
            document.getElementById("inputB" + id).removeAttribute("hidden");
            }
        </script>
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
        crossorigin="anonymous"></script>
        <script src="/miniProject2/script.js"></script>
    </body>
</html>